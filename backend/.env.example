# Leave unset to use local SQLite (./fyi.db) for quick local dev.
# For Neon/Postgres in production:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname
DATABASE_URL=

# Shared secret required in the X-Admin-Key header to POST /api/articles
# (writing new articles from the /admin page). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required — the write endpoint refuses all requests until this is set.
ADMIN_API_KEY=

# Where the "Send us a tip" form actually delivers to. Kept server-side
# only (never in frontend code) — see routers/tip.py. Get this from your
# Formspree dashboard: your form -> Integration tab -> looks like
# https://formspree.io/f/xxxxxxxx. Required — /api/tip refuses to submit
# without it. Also make sure reCAPTCHA is OFF for this form in Formspree's
# settings, since this backend posts to it directly (no browser widget).
FORMSPREE_ENDPOINT=

# Read/write token for the Vercel Blob store backing image uploads
# (POST /api/uploads — brand header banners + article header images from
# /admin). Create a Blob store in the Vercel dashboard: Storage -> Create
# Database -> Blob, then copy the token it generates. Required — /api/uploads
# refuses to accept files until this is set.
BLOB_READ_WRITE_TOKEN=

# Optional hardening on top of ADMIN_API_KEY: requires a solved Cloudflare
# Turnstile challenge before GET /api/admin/whoami (the /admin key-entry
# step) will even check the key — see auth.py's verify_turnstile. Leave
# unset to skip this (the key check alone still applies); /admin only shows
# the widget when the matching frontend env var, NEXT_PUBLIC_TURNSTILE_SITE_KEY,
# is also set. Get both from the Cloudflare dashboard: Turnstile -> Add site
# (any hostname works, no need to put the domain's DNS on Cloudflare) ->
# copy the Site Key (frontend) and Secret Key (this one).
TURNSTILE_SECRET_KEY=
