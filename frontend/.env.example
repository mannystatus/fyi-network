NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile site key for the /admin key-entry widget — public,
# safe to expose client-side (pairs with the backend's private
# TURNSTILE_SECRET_KEY, see backend/.env.example). Leave unset to skip
# showing the widget entirely.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
